{
  "uris": ["/api/auth", "/api/auth/*"],
  "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"],
  "upstream": {
    "type": "roundrobin",
    "nodes": {
      "user-service:8001": 1
    }
  },
  "plugins": {
    "proxy-rewrite": {
      "regex_uri": ["^/api/auth(/.*)?$", "/auth$1"]
    }
  }
}
