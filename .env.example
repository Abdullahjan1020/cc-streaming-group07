# Application
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=streaming_platform
USER_MONGODB_DATABASE=user_db
PRODUCT_MONGODB_DATABASE=product_db
ORDER_MONGODB_DATABASE=order_db
NOTIFICATION_MONGODB_DATABASE=notification_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Internal service URLs
USER_SERVICE_URL=http://localhost:8001
PRODUCT_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003
NOTIFICATION_SERVICE_URL=http://localhost:8004

# Authentication
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
APISIX_ADMIN_KEY=apisix-local-admin-key-change-before-use
